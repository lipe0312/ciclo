// Cloudflare Worker "ciclo" — plano gratuito (Workers + D1 + R2 [+ Workers AI opcional]).
// Primeira vez: `npm run cf:setup` (cria D1 e R2 e grava o database_id aqui). Detalhes: docs/05-deploy-gratis.md
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "ciclo",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/mcp", "/mcp/*"],
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "ciclo-db", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "ciclo-media" }],
  // Transcrição de voz (Whisper, 10 mil "neurons"/dia grátis ≈ 200 min de áudio). Descomente depois do `wrangler login`:
  // "ai": { "binding": "AI" },
  // Dev local: o Workers AI não roda offline; com o binding ligado o `wrangler dev` usa o serviço REMOTO e exige `wrangler login`
  // (o app usa o reconhecimento de voz do navegador enquanto isso). Em produção basta descomentar a linha acima e fazer o deploy.
  // 1 min: Web Push do fim do descanso (#25). O fechamento de treinos esquecidos roda a cada 30 min dentro do mesmo cron.
  "triggers": { "crons": ["* * * * *"] },
  "vars": { "APP_VERSION": "0.1.0" },
  "observability": { "enabled": true },
  "upload_source_maps": false
}
